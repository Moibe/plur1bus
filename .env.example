# Copia este archivo a `.env` (NO lo commitees). Por ahora el proyecto corre solo local.
# Comentarios siempre en su propia línea: `node --env-file` no quita los que van al final.

# Puerto reservado para esta app (en el droplet los Node van de 100 en 100)
PORT=4400
# Siempre localhost; en el droplet nginx hace el proxy reverso
HOST=127.0.0.1
# Local con `node build`; en el droplet sería https://<dominio>
ORIGIN=http://localhost:4400
# SQLite (better-sqlite3 + drizzle)
DATABASE_URL=./local.db
# FastAPI de cálculo (repo hermano ../plur1bus-api)
PUBLIC_API_URL=http://127.0.0.1:8004
