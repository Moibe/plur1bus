# Copia este archivo a `.env` (NO lo commitees). Por ahora el proyecto corre solo local.
PORT=4400                     # Puerto reservado para esta app (en el droplet los Node van de 100 en 100)
HOST=127.0.0.1                # Siempre localhost; en el droplet nginx hace el proxy reverso
ORIGIN=http://localhost:4400  # Local con `node build`; en el droplet sería https://<dominio>
DATABASE_URL=./local.db       # SQLite (better-sqlite3 + drizzle)
PUBLIC_API_URL=http://127.0.0.1:8004  # FastAPI de cálculo (repo hermano ../plur1bus-api)
